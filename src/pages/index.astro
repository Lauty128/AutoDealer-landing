---
import LandingPage from '../components/LandingPage.tsx';
import '../index.css';

const title = "AutoDealer - Ecosistema de Software para Concesionarios, Agencias y Talleres Automotrices";
const description = "Infraestructura digital completa para el rubro automotor: Catálogo AutoDealer (30 días gratis), AutoDealer Dedicado (ERP para concesionarios de usados y 0km), AutoWorth (cotizador digital gratuito) y AutoFixer (gestión para talleres mecánicos y detailing).";
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://autodealer.com.ar');
const ogImage = "https://autodealer.com.ar/logo.png";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#dcac0c" />

		<!-- Preconnect Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="gestión de concesionarios, software automotriz, ERP para agencias de autos, Catálogo AutoDealer, AutoWorth, AutoFixer, AutoDealer Dedicado, catálogo online vehículos, generador de flyers autos, precios de autos Argentina, sistema para talleres mecánicos, software detailing, cuentas corrientes concesionario" />
		<meta name="author" content="Lautaro Silverii" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:site_name" content="AutoDealer" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" is:inline>
			[
				{
					"@context": "https://schema.org",
					"@type": "Organization",
					"name": "AutoDealer",
					"url": "https://autodealer.com.ar",
					"logo": "https://autodealer.com.ar/logo.png",
					"description": "Infraestructura tecnológica integral para concesionarios, agencias de vehículos, talleres mecánicos y centros de detailing en Argentina.",
					"founder": {
						"@type": "Person",
						"name": "Lautaro Silverii"
					},
					"contactPoint": {
						"@type": "ContactPoint",
						"telephone": "+54-2284-552868",
						"contactType": "sales",
						"email": "administracion@autodealer.com.ar",
						"areaServed": "AR",
						"availableLanguage": "Spanish"
					},
					"address": {
						"@type": "PostalAddress",
						"addressLocality": "Buenos Aires",
						"addressCountry": "AR"
					}
				},
				{
					"@context": "https://schema.org",
					"@type": "SoftwareApplication",
					"name": "Ecosistema AutoDealer",
					"operatingSystem": "Web",
					"applicationCategory": "BusinessApplication",
					"description": "Ecosistema de software automotor compuesto por Catálogo AutoDealer, AutoDealer Dedicado, AutoWorth y AutoFixer.",
					"author": {
						"@type": "Person",
						"name": "Lautaro Silverii"
					},
					"offers": [
						{
							"@type": "Offer",
							"name": "AutoWorth",
							"description": "La revista de autos llevada a digital para consultar precios del mercado en celular y PC. 100% gratis.",
							"priceCurrency": "ARS",
							"price": "0",
							"availability": "https://schema.org/InStock"
						},
						{
							"@type": "Offer",
							"name": "Catálogo AutoDealer",
							"description": "Espacio digital para concesionarios, listado de vehículos, generador de flyers y envío de fichas a clientes. 30 días gratis iniciales.",
							"priceCurrency": "ARS",
							"price": "20000",
							"availability": "https://schema.org/InStock"
						},
						{
							"@type": "Offer",
							"name": "AutoDealer Dedicado",
							"description": "ERP completo para concesionarios de usados y 0km: flota, ventas, cajas, cuentas corrientes con portal de clientes, empleados y comisiones.",
							"priceCurrency": "ARS",
							"price": "0",
							"availability": "https://schema.org/InStock"
						},
						{
							"@type": "Offer",
							"name": "AutoFixer",
							"description": "Sistema de gestión para talleres mecánicos y detailing con órdenes de trabajo progresivas, link de seguimiento en vivo para clientes, cajas y cuentas corrientes.",
							"priceCurrency": "ARS",
							"price": "0",
							"availability": "https://schema.org/InStock"
						}
					]
				}
			]
		</script>
	</head>
	<body>
		<LandingPage client:load />
	</body>
</html>
